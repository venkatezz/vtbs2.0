# VT Business Solutions - Frontend Environment Configuration
# Copy this file to .env.local to configure custom submission delivery

# Option 1: Web3Forms Access Key (https://web3forms.com/)
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Option 2: Custom Webhook / Backend Endpoint URL (e.g. Google Apps Script / AWS Lambda)
# VITE_CONTACT_API_URL=https://your-api-endpoint.com/submit
